# Copy this to .env.development (gitignored) to override the API URL for `npm run dev`.
# Don't put this in a bare `.env` - Vite loads that for every mode, including
# `npm run build`, and would bake a localhost URL into the production bundle.
#
# Production doesn't need this at all: the app is served from the same host as the
# API (see vite.config.ts + Program.cs), so it defaults to a same-origin relative
# URL automatically.
VITE_API_BASE_URL=http://localhost:5000
